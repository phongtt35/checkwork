rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Helpers ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email != null && request.auth.token.email_verified == true;
    }

    function userEmail() {
      return request.auth.token.email.lower();
    }

    function emailToSafeKey(email) {
      return email.lower().replace('@', '_at_').replace('\\.', '_dot_').replace('\\+', '_plus_');
    }

    function isAdmin() {
      return isVerifiedUser() && (
        userEmail() == 'phongtt35@fpt.edu.vn' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        exists(/databases/$(database)/documents/adminInvites/$(emailToSafeKey(userEmail())))
      );
    }

    function studentBinding(uid) {
      return get(/databases/$(database)/documents/studentBindings/$(uid)).data;
    }

    function hasActiveStudentBinding(uid) {
      return exists(/databases/$(database)/documents/studentBindings/$(uid)) &&
        studentBinding(uid).active == true;
    }

    // --- Validation Blueprints ---
    function isValidStudent(data) {
      return data.keys().hasAll(['email', 'fullName', 'groupCode', 'active', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['email', 'fullName', 'groupCode', 'uid', 'photoURL', 'active', 'createdAt', 'updatedAt', 'lastLoginAt']) &&
        data.email is string && data.email.size() >= 5 && data.email.size() <= 150 &&
        data.email.matches('^[a-z0-9._%+\\-]+@[a-z0-9.\\-]+\\.[a-z]{2,}$') &&
        data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 120 &&
        data.groupCode is string && data.groupCode.size() >= 1 && data.groupCode.size() <= 40 &&
        data.active is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        (!('uid' in data) || data.uid == null || (data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128)) &&
        (!('photoURL' in data) || data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 500)) &&
        (!('lastLoginAt' in data) || data.lastLoginAt == null || data.lastLoginAt is timestamp);
    }

    function isValidStudentBinding(data) {
      return data.keys().hasAll(['studentId', 'groupCode', 'active', 'updatedAt']) &&
        data.keys().hasOnly(['studentId', 'groupCode', 'active', 'updatedAt']) &&
        isValidId(data.studentId) &&
        data.groupCode is string && data.groupCode.size() >= 1 && data.groupCode.size() <= 40 &&
        data.active is bool &&
        data.updatedAt is timestamp;
    }

    function isValidGroupTask(data) {
      return data.keys().hasAll(['groupCode', 'title', 'description', 'priority', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'groupCode', 'title', 'description', 'priority', 'status',
          'assignedToStudentId', 'assignedToUid', 'assignedToName',
          'claimedAt', 'completedAt', 'createdAt', 'updatedAt'
        ]) &&
        data.groupCode is string && data.groupCode.size() >= 1 && data.groupCode.size() <= 40 &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 300 &&
        data.description is string && data.description.size() <= 500 &&
        data.priority in ['high', 'medium', 'low'] &&
        data.status in ['open', 'claimed', 'completed'] &&
        (!('assignedToStudentId' in data) || data.assignedToStudentId == null || isValidId(data.assignedToStudentId)) &&
        (!('assignedToUid' in data) || data.assignedToUid == null || (data.assignedToUid is string && data.assignedToUid.size() >= 1 && data.assignedToUid.size() <= 128)) &&
        (!('assignedToName' in data) || data.assignedToName == null || (data.assignedToName is string && data.assignedToName.size() <= 120)) &&
        (!('claimedAt' in data) || data.claimedAt == null || data.claimedAt is timestamp) &&
        (!('completedAt' in data) || data.completedAt == null || data.completedAt is timestamp) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCheckin(data) {
      return data.keys().hasAll([
          'studentId', 'studentUid', 'studentEmail', 'studentName', 'groupCode',
          'dateKey', 'status', 'tasks', 'totalTasks', 'completedCount', 'incompleteCount',
          'checkInAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'studentId', 'studentUid', 'studentEmail', 'studentName', 'groupCode',
          'dateKey', 'status', 'tasks', 'totalTasks', 'completedCount', 'incompleteCount',
          'dailyNote', 'checkInAt', 'checkOutAt', 'updatedAt'
        ]) &&
        isValidId(data.studentId) &&
        data.studentUid is string && data.studentUid.size() >= 1 && data.studentUid.size() <= 128 &&
        data.studentEmail is string && data.studentEmail.size() >= 5 && data.studentEmail.size() <= 150 &&
        data.studentName is string && data.studentName.size() >= 1 && data.studentName.size() <= 120 &&
        data.groupCode is string && data.groupCode.size() >= 1 && data.groupCode.size() <= 40 &&
        data.dateKey is string && data.dateKey.size() == 10 && data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.status in ['checked_in', 'checked_out'] &&
        data.tasks is list && data.tasks.size() >= 1 && data.tasks.size() <= 30 &&
        data.tasks[0] is map &&
        data.tasks[0].keys().hasAll(['id', 'title', 'status', 'reason', 'blocker']) &&
        data.tasks[0].keys().hasOnly(['id', 'title', 'status', 'reason', 'blocker', 'groupTaskId']) &&
        data.tasks[0].id is string && data.tasks[0].id.size() >= 1 && data.tasks[0].id.size() <= 64 &&
        data.tasks[0].title is string && data.tasks[0].title.size() >= 1 && data.tasks[0].title.size() <= 300 &&
        data.tasks[0].status in ['pending', 'completed', 'incomplete'] &&
        data.tasks[0].reason is string && data.tasks[0].reason.size() <= 500 &&
        data.tasks[0].blocker is string && data.tasks[0].blocker.size() <= 500 &&
        (!('groupTaskId' in data.tasks[0]) || data.tasks[0].groupTaskId == null || isValidId(data.tasks[0].groupTaskId)) &&
        data.totalTasks is int && data.totalTasks >= 1 && data.totalTasks <= 30 &&
        data.totalTasks == data.tasks.size() &&
        data.completedCount is int && data.completedCount >= 0 && data.completedCount <= 30 &&
        data.incompleteCount is int && data.incompleteCount >= 0 && data.incompleteCount <= 30 &&
        (data.completedCount + data.incompleteCount) <= data.totalTasks &&
        (!('dailyNote' in data) || (data.dailyNote is string && data.dailyNote.size() <= 1000)) &&
        data.checkInAt is timestamp &&
        (!('checkOutAt' in data) || data.checkOutAt == null || data.checkOutAt is timestamp) &&
        data.updatedAt is timestamp;
    }

    function isValidAdminUser(data) {
      return data.keys().hasAll(['email', 'displayName', 'role', 'createdAt']) &&
        data.keys().hasOnly(['email', 'displayName', 'role', 'createdAt']) &&
        data.email is string && data.email.size() >= 5 && data.email.size() <= 150 &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
        data.role == 'admin' &&
        data.createdAt is timestamp;
    }

    function isValidAdminInvite(data) {
      return data.keys().hasAll(['email', 'addedBy', 'createdAt']) &&
        data.keys().hasOnly(['email', 'addedBy', 'createdAt']) &&
        data.email is string && data.email.size() >= 5 && data.email.size() <= 150 &&
        data.email.matches('^[a-z0-9._%+\\-]+@[a-z0-9.\\-]+\\.[a-z]{2,}$') &&
        data.addedBy is string && data.addedBy.size() >= 1 && data.addedBy.size() <= 150 &&
        data.createdAt is timestamp;
    }

    function isValidSystemConfig(data) {
      return data.keys().hasAll(['organizationName', 'academicTerm', 'totalResets', 'updatedAt']) &&
        data.keys().hasOnly([
          'organizationName', 'academicTerm', 'totalResets', 'lastResetAt',
          'allowCustomStudentTasks', 'updatedAt'
        ]) &&
        data.organizationName is string && data.organizationName.size() >= 1 && data.organizationName.size() <= 120 &&
        data.academicTerm is string && data.academicTerm.size() >= 1 && data.academicTerm.size() <= 60 &&
        data.totalResets is int && data.totalResets >= 0 &&
        (!('lastResetAt' in data) || data.lastResetAt == null || data.lastResetAt is timestamp) &&
        (!('allowCustomStudentTasks' in data) || data.allowCustomStudentTasks is bool) &&
        data.updatedAt is timestamp;
    }

    function isValidAdminSettings(data) {
      return data.keys().hasAll(['primaryAdminEmail', 'updatedAt']) &&
        data.keys().hasOnly(['primaryAdminEmail', 'updatedAt']) &&
        data.primaryAdminEmail is string &&
        data.primaryAdminEmail.size() >= 5 &&
        data.primaryAdminEmail.size() <= 150 &&
        data.primaryAdminEmail.matches('^[a-z0-9._%+\\-]+@[a-z0-9.\\-]+\\.[a-z]{2,}$') &&
        data.updatedAt is timestamp;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['action', 'actorUid', 'actorEmail', 'details', 'createdAt']) &&
        data.keys().hasOnly(['action', 'actorUid', 'actorEmail', 'details', 'createdAt']) &&
        data.action in ['import_students', 'import_tasks', 'reset_checkins', 'update_config'] &&
        data.actorUid == request.auth.uid &&
        data.actorEmail == userEmail() &&
        data.details is string && data.details.size() >= 1 && data.details.size() <= 400 &&
        data.createdAt is timestamp;
    }

    // --- Collection Rules ---

    // 1. Students Roster
    match /students/{studentId} {
      allow get: if isValidId(studentId) && isVerifiedUser() && (
        existing().email == userEmail() ||
        existing().uid == request.auth.uid ||
        isAdmin()
      );

      allow list: if isVerifiedUser() && (
        resource.data.email == userEmail() ||
        resource.data.uid == request.auth.uid ||
        isAdmin()
      );

      allow create: if isValidId(studentId) &&
        isAdmin() &&
        isValidStudent(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isValidId(studentId) &&
        isVerifiedUser() &&
        isValidStudent(incoming()) &&
        incoming().updatedAt == request.time &&
        incoming().createdAt == existing().createdAt && (
          isAdmin() ||
          (
            existing().active == true &&
            existing().email == userEmail() &&
            (existing().uid == null || existing().uid == request.auth.uid) &&
            incoming().uid == request.auth.uid &&
            incoming().email == existing().email &&
            incoming().fullName == existing().fullName &&
            incoming().groupCode == existing().groupCode &&
            incoming().active == existing().active &&
            incoming().diff(existing()).affectedKeys().hasOnly(['uid', 'photoURL', 'lastLoginAt', 'updatedAt'])
          )
        );

      allow delete: if isValidId(studentId) && isAdmin();
    }

    // 2. Student Bindings (UID -> verified studentId & groupCode)
    match /studentBindings/{uid} {
      allow get: if isValidId(uid) && isVerifiedUser() && (uid == request.auth.uid || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isValidId(uid) &&
        isVerifiedUser() &&
        isValidStudentBinding(incoming()) &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (
            uid == request.auth.uid &&
            exists(/databases/$(database)/documents/students/$(incoming().studentId)) &&
            get(/databases/$(database)/documents/students/$(incoming().studentId)).data.email == userEmail() &&
            get(/databases/$(database)/documents/students/$(incoming().studentId)).data.groupCode == incoming().groupCode &&
            get(/databases/$(database)/documents/students/$(incoming().studentId)).data.active == incoming().active &&
            incoming().active == true
          )
        );
      allow delete: if isValidId(uid) && isAdmin();
    }

    // 3. Group Tasks Backlog
    match /groupTasks/{taskId} {
      allow get: if isValidId(taskId) && isVerifiedUser() && (
        isAdmin() ||
        (hasActiveStudentBinding(request.auth.uid) && existing().groupCode == studentBinding(request.auth.uid).groupCode)
      );

      allow list: if isVerifiedUser() && (
        isAdmin() ||
        (hasActiveStudentBinding(request.auth.uid) && resource.data.groupCode == studentBinding(request.auth.uid).groupCode)
      );

      allow create: if isValidId(taskId) &&
        isAdmin() &&
        isValidGroupTask(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isValidId(taskId) &&
        isVerifiedUser() &&
        isValidGroupTask(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (
            hasActiveStudentBinding(request.auth.uid) &&
            existing().groupCode == studentBinding(request.auth.uid).groupCode &&
            existing().status == 'open' &&
            incoming().status == 'claimed' &&
            incoming().assignedToUid == request.auth.uid &&
            incoming().assignedToStudentId == studentBinding(request.auth.uid).studentId &&
            incoming().claimedAt == request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'assignedToStudentId', 'assignedToUid', 'assignedToName', 'claimedAt', 'updatedAt'
            ])
          ) ||
          (
            hasActiveStudentBinding(request.auth.uid) &&
            existing().groupCode == studentBinding(request.auth.uid).groupCode &&
            existing().status == 'claimed' &&
            existing().assignedToUid == request.auth.uid &&
            incoming().status == 'open' &&
            incoming().assignedToStudentId == null &&
            incoming().assignedToUid == null &&
            incoming().assignedToName == null &&
            incoming().claimedAt == null &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'assignedToStudentId', 'assignedToUid', 'assignedToName', 'claimedAt', 'updatedAt'
            ])
          ) ||
          (
            hasActiveStudentBinding(request.auth.uid) &&
            existing().groupCode == studentBinding(request.auth.uid).groupCode &&
            existing().status == 'claimed' &&
            existing().assignedToUid == request.auth.uid &&
            incoming().status == 'completed' &&
            incoming().completedAt == request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'completedAt', 'updatedAt'
            ])
          )
        );

      allow delete: if isValidId(taskId) && isAdmin();
    }

    // 4. Daily Check-ins & Check-outs
    match /checkins/{checkinId} {
      allow get: if isValidId(checkinId) && isVerifiedUser() && (
        existing().studentUid == request.auth.uid ||
        existing().studentEmail == userEmail() ||
        isAdmin()
      );

      allow list: if isVerifiedUser() && (
        resource.data.studentUid == request.auth.uid ||
        resource.data.studentEmail == userEmail() ||
        isAdmin()
      );

      allow create: if isValidId(checkinId) &&
        isVerifiedUser() &&
        isValidCheckin(incoming()) &&
        incoming().studentUid == request.auth.uid &&
        incoming().studentEmail == userEmail() &&
        incoming().status == 'checked_in' &&
        incoming().checkInAt == request.time &&
        incoming().updatedAt == request.time &&
        (!('checkOutAt' in incoming()) || incoming().checkOutAt == null) &&
        checkinId == (incoming().studentId + '_' + incoming().dateKey) &&
        exists(/databases/$(database)/documents/students/$(incoming().studentId)) &&
        get(/databases/$(database)/documents/students/$(incoming().studentId)).data.email == userEmail() &&
        get(/databases/$(database)/documents/students/$(incoming().studentId)).data.active == true;

      allow update: if isValidId(checkinId) &&
        isVerifiedUser() &&
        isValidCheckin(incoming()) &&
        incoming().studentId == existing().studentId &&
        incoming().studentUid == existing().studentUid &&
        incoming().studentEmail == existing().studentEmail &&
        incoming().dateKey == existing().dateKey &&
        incoming().checkInAt == existing().checkInAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (
            existing().studentUid == request.auth.uid &&
            existing().status == 'checked_in' &&
            incoming().status == 'checked_in' &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'tasks', 'totalTasks', 'completedCount', 'incompleteCount', 'dailyNote', 'updatedAt'
            ])
          ) ||
          (
            existing().studentUid == request.auth.uid &&
            existing().status == 'checked_in' &&
            incoming().status == 'checked_out' &&
            incoming().checkOutAt == request.time &&
            (incoming().completedCount + incoming().incompleteCount) == incoming().totalTasks &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'tasks', 'totalTasks', 'completedCount', 'incompleteCount',
              'dailyNote', 'checkOutAt', 'updatedAt'
            ])
          )
        );

      allow delete: if isValidId(checkinId) && isAdmin();
    }

    // 5. Admins
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && isVerifiedUser() && (adminId == request.auth.uid || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(adminId) &&
        isVerifiedUser() &&
        isValidAdminUser(incoming()) &&
        incoming().createdAt == request.time && (
          isAdmin() ||
          (
            adminId == request.auth.uid &&
            incoming().email == userEmail() &&
            (
              userEmail() == 'phongtt35@fpt.edu.vn' ||
              exists(/databases/$(database)/documents/adminInvites/$(emailToSafeKey(userEmail())))
            )
          )
        );
      allow update: if isValidId(adminId) && isAdmin() && isValidAdminUser(incoming()) && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(adminId) && isAdmin() && adminId != request.auth.uid;
    }

    // 6. Admin Invites
    match /adminInvites/{inviteId} {
      allow get: if isValidId(inviteId) && isVerifiedUser() && (inviteId == emailToSafeKey(userEmail()) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(inviteId) &&
        isAdmin() &&
        isValidAdminInvite(incoming()) &&
        incoming().createdAt == request.time &&
        inviteId == emailToSafeKey(incoming().email);
      allow update: if false;
      allow delete: if isValidId(inviteId) && isAdmin();
    }

    // 7. System Configuration (PII-free)
    match /systemConfig/{configId} {
      allow get: if isValidId(configId) && isVerifiedUser();
      allow list: if isAdmin();
      allow create: if isValidId(configId) && isAdmin() && isValidSystemConfig(incoming()) && incoming().updatedAt == request.time;
      allow update: if isValidId(configId) && isAdmin() && isValidSystemConfig(incoming()) && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    // 8. Admin Settings (Admin-only PII config)
    match /adminSettings/{settingId} {
      allow get, list: if isAdmin();
      allow create, update: if isValidId(settingId) && isAdmin() && isValidAdminSettings(incoming()) && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    // 9. Audit Logs
    match /auditLogs/{logId} {
      allow get, list: if isAdmin();
      allow create: if isValidId(logId) && isAdmin() && isValidAuditLog(incoming()) && incoming().createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
